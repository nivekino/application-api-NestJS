root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf
# Mismo ancho que printWidth en .prettierrc: Prettier lee este archivo y "off" lo
# interpretaba como ancho infinito (lineas de 170 caracteres sin queja).
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
