# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=changeme
DB_NAME=application_api

# Secreto para firmar los JWT. Usa un valor largo y aleatorio en cada entorno.
# NUNCA subas el secreto real al repositorio.
JWT_SECRET=replace-with-a-long-random-secret
