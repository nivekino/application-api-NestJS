{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/harness/check-changed.mjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/harness/verify.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "PowerShell(npm run build)",
      "PowerShell(npm test)",
      "PowerShell(npm test:*)",
      "PowerShell(npm run test:e2e)",
      "PowerShell(npm run test:cov)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run lint:check)",
      "PowerShell(npm run format)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run harness:verify)",
      "PowerShell(npm run harness:estructura)",
      "PowerShell(node scripts/harness/verify.mjs)",
      "PowerShell(node scripts/harness/verify.mjs --estructura)",
      "PowerShell(node scripts/harness/check-changed.mjs)",
      "PowerShell(npx eslint:*)",
      "PowerShell(npx tsc:*)",
      "PowerShell(npx jest:*)",
      "PowerShell(npx prettier:*)",
      "PowerShell(git status)",
      "PowerShell(git status --short)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)"
    ]
  }
}
