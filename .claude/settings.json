{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/harness/lint-changed.mjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/harness/verify.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run harness:verify)",
      "Bash(npm run lint)",
      "Bash(node scripts/harness/verify.mjs)",
      "Bash(node scripts/harness/lint-changed.mjs)",
      "Bash(npx eslint:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ]
  }
}
