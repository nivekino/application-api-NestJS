{
  // Configuración base de TypeScript para NestJS (CommonJS + decoradores legacy).
  // El build de producción usa tsconfig.build.json, que extiende este y excluye
  // pruebas; las e2e usan test/tsconfig.json.
  //
  // Compilador: TypeScript 6.0.x (fijado con `~` en package.json). Es el techo del
  // toolchain, no del lenguaje: typescript-eslint declara `typescript <6.1.0` y
  // ts-jest `<7`. TypeScript 7 (compilador nativo) queda bloqueado por los dos.
  // Detalle y condiciones para subir: docs/verifications.md §6.
  "compilerOptions": {
    // --- Objetivo y librerías ---
    // Base oficial `@tsconfig/node24`: target/lib es2024 (Node 24 LTS, Krypton).
    "target": "ES2024",
    // Solo "ES2024", sin las entradas `ESNext.*` que sí trae la base oficial de
    // Node 24. Motivo medido, no preferencia: bajo TypeScript 6 `ESNext.Iterator`
    // se expande a `es2025.iterator`, y typescript-eslint 8.69.0 no conoce ese
    // valor — falla con "Parsing error: Invalid value for lib provided:
    // es2025.iterator" en TODOS los archivos, dejando el linter inservible. El
    // tope de `lib`/`target` aquí lo pone el linter, no el compilador.
    "lib": ["ES2024"],
    // Obligatorio declararlo desde TypeScript 6: ya NO incluye automáticamente
    // todos los @types instalados. Omitirlo deja los specs de src/ sin
    // describe/it/expect ("Cannot find name 'describe'"). `jest` va aquí y no solo
    // en la config de pruebas porque los `*.spec.ts` viven dentro de src/.
    "types": ["node", "jest"],

    // --- Módulos y salida ---
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist",
    // Explícito a propósito: fija el layout de `dist/` (dist/main.js, no
    // dist/src/main.js) para que `npm run start:prod` -> `node dist/main` siga
    // resolviendo. Desde TypeScript 6 el valor por omisión es el directorio del
    // tsconfig, así que sin declararlo la salida se movería en silencio.
    "rootDir": "./src",
    // Sin `esModuleInterop` ni `allowSyntheticDefaultImports`: desde TypeScript 6
    // son obligatoriamente `true` y declararlos es ruido. Sin `baseUrl`: está
    // deprecado desde 6 y desaparece en 7; aquí no había `paths` que mapear.

    // --- Decoradores ---
    // NestJS y TypeORM dependen de los decoradores legacy (Stage 2) y de los
    // metadatos de tipo en runtime: de ahí sale la inyección de dependencias.
    // NO migres a los decoradores estándar de TS 5+: `emitDecoratorMetadata` no
    // aplica a ellos y la DI de NestJS deja de resolver tipos.
    // Por lo mismo NO habilites `verbatimModuleSyntax` ni la regla
    // `consistent-type-imports` del linter: convertirían los imports de tipos en
    // `import type`, y un tipo borrado en compilación no puede emitirse como
    // metadato. Tampoco `erasableSyntaxOnly`: prohíbe las parameter properties
    // (`constructor(private readonly x: X)`) que son la base de la DI de NestJS.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // --- Rigor de tipos ---
    "strict": true,
    // Única excepción a `strict`, y es obligatoria aquí: las entidades de TypeORM
    // y los DTOs de class-validator declaran propiedades que se llenan FUERA del
    // constructor (el ORM al hidratar, el ValidationPipe al transformar). Con este
    // check activo, `@Column() username: string;` sería un error de compilación en
    // cada entidad. No lo "arregles" poniéndolo en true: rompe el build completo.
    "strictPropertyInitialization": false,
    // Un índice fuera de rango o una llave ausente devuelven `T | undefined`, no
    // `T`. Obliga a comprobar antes de usar (p. ej. `mock.calls[0]`), que es
    // exactamente el tipo de error que un test con mocks deja pasar en silencio.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Verifica el código propio pero no los .d.ts de node_modules: sin esto, un
    // tipo roto en una dependencia transitiva tumba el build propio.
    "skipLibCheck": true,

    // --- Desarrollo ---
    "declaration": true,
    "sourceMap": true,
    "removeComments": true,
    "incremental": true
  },
  // `test/` tiene su propio tsconfig (test/tsconfig.json): esas pruebas corren
  // transpiladas a CommonJS por ts-jest, no bajo la resolución ESM que nodenext
  // aplica a los import() dinámicos. Ahí se explica el detalle.
  "exclude": ["node_modules", "dist", "coverage", "test"]
}
